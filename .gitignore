# Dependencies and build output
node_modules/
dist/
coverage/
.cache/
*.tsbuildinfo

# Environment and secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# Character art and rights-restricted assets live outside this repo until the
# rights review is complete (see docs/characters/rights.md). Only the folder's README is
# tracked, so the folder exists for the app to read owner-supplied images locally.
**/assets/characters/*
!**/assets/characters/README.md
apps/mobile/public/*
apps/mobile/assets/fusion.mp4

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.log

# Office lock files
~$*

# Built app packages (production-fix-plan S12): never committed.
*.apk
*.aab
