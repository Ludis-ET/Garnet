{
  "name": "@garnet/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Garnet mobile app (Phase 2: design-first UI prototype on local mock data; no backend).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@garnet/domain": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "temporal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "~29.5.14",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.18",
    "fast-check": "catalog:",
    "jest-expo": "~57.0.5",
    "test-renderer": "~1.2.0",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-.*|react-navigation|@react-navigation/.*|react-native-.*|@tanstack/.*|temporal-.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/.cache/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
