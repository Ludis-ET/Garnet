{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // NestJS decorators. Dependencies are always named with @Inject(...), so nothing relies on
    // emitted design-time metadata (tsx and Vitest don't emit it).
    "experimentalDecorators": true,
    // @garnet/db's sources import with explicit .ts extensions.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "vitest.config.ts"]
}
