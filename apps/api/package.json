    "@nestjs/platform-fastify": "12.2.0",
    "fastify": "5.12.7",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
