# Local development only. Copy to apps/api/.env (git-ignored) and adjust. Never commit .env.

GARNET_API_DATABASE_URL=postgres://garnet_api:garnet-api-local@127.0.0.1:55432/garnet
GARNET_API_HOST=127.0.0.1
GARNET_API_PORT=3000
GARNET_API_LOG_LEVEL=info

# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GARNET_AUTH_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
GARNET_AUTH_BASE_URL=http://127.0.0.1:3000

# --- ADR-0006 / P-25 / P-18 values, chosen under owner direction P-78 (2026-11-04). ---------
# Still Proposed in the decision log: the code has no defaults, so they live here.
# NIST SP 800-63B-4: at least 15 characters when a password is the only factor (P-25 said 12).
GARNET_PASSWORD_MIN_LENGTH=15
# A session ends after 30 days unused (extended at most once a day while in use)...
GARNET_SESSION_DAYS=30
GARNET_SESSION_REFRESH_HOURS=24
# ...and 90 days after sign-in however much it is used.
GARNET_SESSION_MAX_DAYS=90
# Per address: at most MAX tries per WINDOW seconds on each sign-in, sign-up, link and reset
# route. Per account, wrong passwords and emails also back off exponentially (P-78). No lockout.
GARNET_AUTH_RATE_WINDOW_SECONDS=60
GARNET_AUTH_RATE_MAX=10
# Single-use email links: confirming an email lasts a day, a password reset 30 minutes.
GARNET_VERIFY_TOKEN_MINUTES=1440
GARNET_RESET_TOKEN_MINUTES=30
# P-18: invitations last at most 24 hours (the database enforces the ceiling).
GARNET_INVITE_TTL_HOURS=24
# -----------------------------------------------------------------------------------------------

# Local Mailpit (infra/docker-compose.yml): every email lands in http://127.0.0.1:8025.
GARNET_SMTP_URL=smtp://127.0.0.1:1025
GARNET_MAIL_FROM=Garnet <hello@garnet.local>

# --- Google and Apple sign-in (P-79): off until set. Never commit real values. ----------------
# Google (free): Google Cloud console > APIs & Services > Credentials > OAuth client ID,
# type "Web application", authorised redirect URI http://127.0.0.1:3000/v1/auth/callback/google
# (see infra/README.md). Both values, or neither.
# GARNET_GOOGLE_CLIENT_ID=
# GARNET_GOOGLE_CLIENT_SECRET=
# Apple (needs the paid Apple Developer Program and an https domain, U-07): the Services ID,
# and a client secret made with: node scripts/apple-client-secret.mjs (lasts at most 6 months).
# GARNET_APPLE_CLIENT_ID=
# GARNET_APPLE_CLIENT_SECRET=
# The iPhone app's bundle id, for Sign in with Apple on the phone itself (optional).
# GARNET_APPLE_BUNDLE_ID=

# --- S3 / Cloudflare R2 Storage for Media (P-76, U-07) ----------------------------------------
# For Cloudflare R2: Endpoint is https://<account_id>.r2.cloudflarestorage.com
# Create token under Cloudflare Dashboard > R2 > Manage R2 API Tokens (Object Read & Write).
# GARNET_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# GARNET_S3_REGION=auto
# GARNET_S3_ACCESS_KEY_ID=
# GARNET_S3_SECRET_ACCESS_KEY=
# GARNET_MEDIA_BUCKET=garnet-media
