{
  "expo": {
    "name": "Garnet",
    "slug": "garnet",
    "version": "0.0.0",
    "scheme": "garnet",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0B12",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.garnet.prototype"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Garnet uses your location while the app is open, rounded to about 10 km, to show how far apart you are. Your partner sees only the distance, never where you are.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "GarnetToday",
              "label": "Garnet today",
              "description": "Garnet, in a look that follows your day.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TwoClocks",
              "label": "Two clocks",
              "description": "Ruby and Sapphire, each in their own part of the day.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ThinkingOfYou",
              "label": "Thinking of you",
              "description": "Opens Garnet to ask before sending a thought.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SomethingWaiting",
              "label": "Something waiting",
              "description": "Shows when a letter or surprise can be opened.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ComingUp",
              "label": "Coming up",
              "description": "How many days until something special.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FarApart",
              "label": "Far apart",
              "description": "How far apart you are, in kilometres.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withWindowsHermesc",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#7B55F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
